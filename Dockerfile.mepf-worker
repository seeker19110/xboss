# Dockerfile.mepf-worker
# Build MEPF-Agents Python worker cho XBoss
# ---------------------------------------------------------------------------
# Stage 1: Builder — cài đặt tất cả dependencies
FROM python:3.12-slim AS builder

WORKDIR /build

# System deps cần cho ezdxf, Pillow, psycopg2, numpy...
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libfreetype6-dev \
    libjpeg-dev \
    libpng-dev \
    libffi-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Cài MEPF-Agents và dependencies của nó
COPY mepf-worker/ ./mepf-agent/
RUN pip install --no-cache-dir --prefix=/install ./mepf-agent/ || \
    pip install --no-cache-dir --prefix=/install \
        langgraph langchain-anthropic langchain-openai \
        ezdxf \
        pillow numpy scipy \
        psycopg2-binary python-dotenv \
        fastapi uvicorn httpx \
        chromadb sentence-transformers \
        pdf2image pytesseract \
        && true

# Cài XBoss worker requirements (psycopg2, dotenv)
COPY scripts/mepf/requirements-worker.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements-worker.txt

# ---------------------------------------------------------------------------
# Stage 2: Runtime — image gọn hơn
FROM python:3.12-slim AS runtime

WORKDIR /app

# Runtime system libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libfreetype6 \
    libjpeg62-turbo \
    libpng16-16 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages từ builder
COPY --from=builder /install /usr/local

# Copy MEPF-Agents source code
COPY mepf-worker/ ./mepf-agent/

# Copy XBoss worker entry point
COPY scripts/mepf/worker_entry.py ./worker_entry.py

# Biến môi trường mặc định (override qua docker-compose env)
# PYTHONPATH phải có CẢ /app/mepf-agent (cho import kiểu `src.x` mà MEPF-Agents tự dùng)
# LẪN /app/mepf-agent/src (cho import phẳng `x`) — thiếu thư mục cha thì `from src.state`
# ném ModuleNotFoundError và worker âm thầm rơi về dry-run.
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/mepf-agent:/app/mepf-agent/src:/app \
    MEPF_WORKER_CONCURRENCY=2 \
    MEPF_DRY_RUN=false \
    MEPF_POLL_INTERVAL=3 \
    MEPF_LEASE_MINUTES=10

# Chạy worker (không expose port — internal daemon)
CMD ["python", "worker_entry.py"]

# Healthcheck: kiểm tra process Python đang chạy
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep -f worker_entry.py > /dev/null || exit 1
