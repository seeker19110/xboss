{
  "//": "Lighthouse CI — ĐO BASELINE hiệu năng/a11y/SEO trên /login (trang công khai).",
  "//2": "A11y đã siết lên 'error' (backlog contrast đã dọn xong — PROGRESS.md); các category khác giữ 'warn'.",
  "//3": "Cân nhắc siết tiếp performance/best-practices/seo khi ổn định.",
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "url": ["http://localhost:3000/login"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
