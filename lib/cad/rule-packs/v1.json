  },
  "flattenPolicy": {
    "source": "M99 §8 AC3 (FR4) — chuẩn đích cho plugin AutoCAD",
    "targetElevation": 0,
    "applyTo": "mọi thực thể (elevation + toạ độ Z)",
    "preserveXyProjection": true,
    "coordinateSystem": "WCS",
    "unit": "mm",
    "originAlignment": "Gốc toạ độ WCS 2D (X:0, Y:0) tại tim giao trục chính",
    "note": "CHƯA CHẮC / chưa có triển khai thật phía server: không có hàm ép Z→0 nào trong lib/cad/dxf-parser.ts — exportDxf giữ nguyên Z của thực thể (chỉ $EXTMIN/$EXTMAX ghi Z=0), còn UI chuẩn hóa mới dừng ở việc đánh dấu wcsConfig.isAligned. Chính sách ghi ở đây là chuẩn đích theo AC3 để plugin (PR4) và tầng 3 cùng bám, không phải mô tả code hiện có."
  }
