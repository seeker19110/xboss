  "purgePolicy": {
    "source": "lib/cad/dxf-parser.ts :: generateStandardizedAutocadScript() + app/engineering/chuan-hoa-ban-ve/page.tsx :: handleRunDeepPurge()/handleAutoHealAll()",
    "autocadCommands": ["-PURGE LA * N", "-PURGE B * N", "AUDIT Y"],
    "purgeUnusedLayers": true,
    "purgeUnusedBlocks": true,
    "audit": true,
    "confirmEachItem": false,
    "keepReferenced": true,
    "deepPurge": {
      "removeZeroLengthLines": true,
      "zeroLengthToleranceMm": 1,
      "removeDuplicateOverlappingLines": true,
      "duplicateKeyRounding": "làm tròn toạ độ X/Y về số nguyên (mm), so cả chiều thuận lẫn chiều ngược",
      "reportEmptyLayers": true,
      "reportAnonymousBlocks": true
    }
  },
