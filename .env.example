# Chuỗi kết nối PostgreSQL (bắt buộc).
# Supabase: Settings → Database → Connection string → URI (password phải URL-encode).
# Hoặc Postgres tự host: postgres://user:password@host:5432/dbname
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Chuỗi bí mật ký cookie phiên đăng nhập (đổi thành chuỗi ngẫu nhiên dài).
# BẮT BUỘC khi chạy production — thiếu sẽ lỗi khi đăng nhập.
XBOSS_SECRET="doi-thanh-chuoi-bi-mat-that-dai"

# Mật khẩu tài khoản admin@xboss.vn tạo lần đầu khi DB trống (chỉ production).
# Dev không cần — sẽ tự seed 4 tài khoản mẫu (admin123/pm123/eng123/sub123).
XBOSS_ADMIN_PASSWORD=""

# ===== Email báo cáo trễ hạn hằng ngày (tuỳ chọn) =====
# Bảo vệ endpoint cron /api/cron/daily-report (Vercel Cron tự gửi Bearer token này).
CRON_SECRET=""
# SMTP gửi mail (Gmail: smtp.gmail.com:587 + App Password; hoặc SMTP bất kỳ).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""           # mặc định: "XBoss" <SMTP_USER>
# Người nhận, phân tách dấu phẩy — bỏ trống = gửi cho mọi Admin + PM trong hệ thống.
REPORT_EMAIL_TO=""
# URL app để chèn link vào email (vd: https://xboss.example.com)
APP_URL=""

# ===== Telegram báo cáo trễ hạn (tuỳ chọn — gửi song song với email) =====
# Tạo bot qua @BotFather → lấy token. Chat ID: thêm bot vào nhóm rồi gọi
# https://api.telegram.org/bot<TOKEN>/getUpdates để xem chat.id (nhiều ID phân tách dấu phẩy).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ===== Secret xác thực webhook đến (BẮT BUỘC nếu dùng bot 2 chiều) =====
# /api/telegram/webhook và /api/zalo/webhook ghi thẳng vào DB và thao tác thay người
# dùng đã liên kết → mặc định TẮT (trả 503) khi thiếu secret, không để mở.
# Telegram: khai lúc đăng ký webhook để Telegram gửi lại qua header
#   X-Telegram-Bot-Api-Secret-Token:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL>/api/telegram/webhook&secret_token=<SECRET>"
# Zalo: gửi kèm header X-Zalo-Webhook-Secret.
TELEGRAM_WEBHOOK_SECRET=""
ZALO_WEBHOOK_SECRET=""

# ===== Web Push (tuỳ chọn — thông báo đẩy tới điện thoại/máy tính) =====
# Sinh cặp key 1 lần: npx web-push generate-vapid-keys
# Không đặt key → nút "Bật thông báo đẩy" tự ẩn, mọi hàm gửi là no-op.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@xboss.vn"

# ===== Đồng bộ hai chiều bảng vật tư ↔ Google Sheet (tuỳ chọn) =====
# 1) Google Cloud → tạo Service Account → tạo JSON key → bật Google Sheets API.
# 2) Mở Google Sheet → Share → cấp quyền Editor cho email service account.
# 3) Dán NGUYÊN nội dung file JSON key vào biến dưới (1 dòng).
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Cách khác thay cho JSON: cặp email + private key (xuống dòng viết "\n").
# GOOGLE_SA_EMAIL=""
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ID spreadsheet (đoạn giữa /d/ và /edit trong URL Google Sheet).
GOOGLE_SHEET_ID=""
# Tên tab chứa vật tư (mặc định "VatTu" nếu để trống).
GOOGLE_SHEET_TAB="VatTu"
# Cron tự đồng bộ định kỳ: GET /api/cron/sync-sheets với Authorization: Bearer $CRON_SECRET
# (dùng chung CRON_SECRET ở trên; bấm nút "Đồng bộ Google Sheet" trên /materials để chạy tay).

# ===== npm run db:seed (tuỳ chọn) =====
# Đường dẫn file Excel gốc để import — mặc định tìm trong attachments/ nếu để trống.
XLSX_FILE=""

# ===== Theo dõi lỗi production — Sentry (tuỳ chọn) =====
# Tạo project trên sentry.io (hoặc self-host) → lấy DSN.
# Không đặt → SDK tự tắt (enabled=false), không gửi gì, không ảnh hưởng build/chạy.
SENTRY_DSN=""
# Cùng DSN, dùng cho phía trình duyệt (biến NEXT_PUBLIC_ duy nhất của dự án — DSN không
# phải bí mật, thiết kế để lộ ra client). Bỏ trống nếu chỉ cần theo dõi lỗi server.
NEXT_PUBLIC_SENTRY_DSN=""
# Chỉ cần khi muốn upload sourcemap thật (đọc được stack trace gốc thay vì code minified) —
# secret riêng, tạo ở Sentry → Settings → Auth Tokens. Thiếu → build vẫn chạy, không upload.
SENTRY_AUTH_TOKEN=""

# ===== Object storage — S3-compatible/MinIO (tuỳ chọn, M54 GĐ1 PR4) =====
# Thiếu bất kỳ biến bắt buộc nào (ENDPOINT/ACCESS_KEY_ID/SECRET_ACCESS_KEY/BUCKET) → dùng
# LOCAL disk data/uploads/ (hành vi mặc định như trước PR4). Đủ 4 biến → mọi upload/tải file
# đi qua S3, key có prefix org/<org_id>/<fileName>.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Vùng — mặc định "us-east-1" nếu bỏ trống (MinIO chấp nhận giá trị bất kỳ).
S3_REGION=""
# Path-style URL — mặc định "true" khi có S3_ENDPOINT (BẮT BUỘC cho MinIO). Đặt "false" khi
# lên S3 thật của AWS dùng virtual-hosted-style.
S3_FORCE_PATH_STYLE=""

# ===== MEPF-Agents Worker (tuỳ chọn — cần chạy service mepf-worker) =====
# Service mepf-worker (Python) xử lý tác vụ AI kỹ thuật ngầm (LangGraph, ezdxf, BIM...).
# Thiếu cả 2 LLM key → worker tự chuyển sang chế độ DRY_RUN (giả lập, không gọi AI).
# Xem docker-compose.yml để chạy: docker compose up -d mepf-worker
#
# LLM provider — khai ít nhất 1 key; MEPF-Agents sẽ dùng key nào có sẵn.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
#
# Cấu hình worker process
MEPF_WORKER_ID="mepf-worker-1"          # ID phân biệt khi chạy nhiều replica
MEPF_WORKER_CONCURRENCY="2"              # Số task xử lý song song trong 1 process
MEPF_DRY_RUN="false"                     # "true" để giả lập không gọi LLM (dùng khi test)
MEPF_POLL_INTERVAL="3"                   # Giây giữa mỗi lần poll hàng đợi
MEPF_LEASE_MINUTES="10"                  # Thời gian giữ lease 1 task (tránh claim chồng)
#
# Model riêng cho từng vai trò agent (để trống = dùng mặc định của MEPF-Agents)
MEPF_CAD_MODEL=""                        # Model cho CAD Agent (vd: claude-3-5-haiku-20241022)
MEPF_REVIEWER_LLM_PROVIDER=""           # Provider cho Reviewer Agent (anthropic/openai)

