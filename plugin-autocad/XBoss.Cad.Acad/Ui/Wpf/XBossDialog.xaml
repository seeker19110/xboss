<!--
  XBossDialog.xaml — KHUNG hộp thoại chung của mọi lệnh XBOSS_* (M106 FR1).

  Cấu trúc: câu dẫn → VÙNG NỘI DUNG (ContentControl bind thẳng vào ViewModel) → vùng lý do →
  dải nút OK/Hủy. Nội dung từng lệnh là một <DataTemplate DataType="{x:Type vm:...ViewModel}">
  trong Window.Resources — CỐ Ý không tạo UserControl + code-behind riêng cho mỗi lệnh:
  DataTemplate không có code-behind, nên thêm hộp thoại ở PR3 là thêm XAML thuần, không sinh thêm
  lớp nào phải stub cho cổng CI (xem plugin-autocad/XBoss.Cad.AcadShim/WpfStub.cs).

  Phím tắt: Enter = OK (nút IsDefault, tự mờ khi CoTheOk = false), Esc = Hủy (nút IsCancel) —
  hành vi sẵn có của WPF, không cần bắt phím trong code-behind.

  Màu lấy từ MauBangWpf (bọc lại MauBang của bảng điều khiển M102) — không hardcode mã màu ở đây.
  Kích thước dùng đơn vị độc lập thiết bị + SizeToContent nên tự đúng ở DPI cao.
-->
<Window x:Class="XBoss.Cad.Acad.Ui.Wpf.XBossDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:XBoss.Cad.Acad.Ui.Wpf"
        xmlns:vm="clr-namespace:XBoss.Cad.Core.Ui.ViewModels;assembly=XBoss.Cad.Core"
        Title="{Binding TieuDe}"
        Width="660"
        SizeToContent="Height"
        MinHeight="260"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        Background="{x:Static wpf:MauBangWpf.Nen}"
        Foreground="{x:Static wpf:MauBangWpf.Chu}">

  <Window.Resources>

    <!-- =========================================================================================
      Kiểu dùng chung.

      ⚠ VÌ SAO PHẢI VIẾT ControlTemplate, KHÔNG ĐẶT SETTER SUÔNG (sự cố 2026-08-26, AutoCAD 2026):
      ControlTemplate MẶC ĐỊNH của WPF (theme Aero2 của Windows) vẽ chrome bằng brush HARD-CODE
      theo theme hệ điều hành và KHÔNG hề đọc Background của control. Đặt
      `<Setter Property="Background">` cho ComboBox/CheckBox/RadioButton/ScrollBar là đặt vào hư
      không: ô vẫn nền SÁNG theo Windows, trong khi Setter Foreground (chữ) thì lại ăn — thành ra
      chữ gần trắng nằm trên nền sáng, đọc như đang bị khóa. Đúng thứ hộp thoại XBOSS_VE đã dính.
      Sửa đúng cách là THAY HẲN template và tự vẽ mọi trạng thái: thường / rê chuột / có focus /
      đang mở / nhập được (IsEditable) / BỊ KHÓA.

      Bảng nào ăn Background của control, bảng nào không (Aero2):
        • ComboBox, ComboBoxItem, CheckBox, RadioButton, ScrollBar, Thumb → KHÔNG (chrome riêng).
        • Button, TextBox → có đọc Background, NHƯNG trigger IsMouseOver/IsPressed/IsEnabled=False
          của template mặc định lại ghi đè bằng màu SÁNG của Windows ⇒ vẫn phải thay template,
          nếu không thì rê chuột / khóa nút OK là lòi mảng sáng ra giữa hộp thoại tối.

      Màu lấy từ MauBangWpf (không hardcode mã màu ở đây — xem MauBang.cs).
    ========================================================================================== -->

    <!-- Nhãn của trường nhập: dùng Chu (không phải ChuMo) — đây là chữ CHÍNH, kỹ sư đọc trên máy
         công trường. ChuMo chỉ dành cho câu giải thích phụ (GhiChu). -->
    <Style x:Key="Nhan" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="Margin" Value="0,10,0,3" />
    </Style>

    <Style x:Key="GhiChu" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuMo}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- ===== Thanh cuộn ===== -->
    <!-- Mọi ScrollViewer trong tệp này (khối xem trước, khối chỉ-đọc, danh sách xổ của ComboBox,
         ô ghi chú nhiều dòng) đều mượn ScrollBar của theme Windows → mặc định là thanh SÁNG.
         Style ngầm dưới đây bắt hết. -->

    <!-- Khoảng trống trên/dưới con trượt: trong suốt nhưng vẫn phải bắt được chuột (nhảy trang). -->
    <Style x:Key="OTrangCuon" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ConTruotCuon" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Than"
                    Margin="2"
                    CornerRadius="3"
                    Background="{x:Static wpf:MauBangWpf.Vien}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Than" Property="Background" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Than" Property="Background" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="NutLui"
                                Style="{StaticResource OTrangCuon}"
                                Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ConTruotCuon}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="NutToi"
                                Style="{StaticResource OTrangCuon}"
                                Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Thanh ngang: Track phải đổi hướng và đổi lệnh, nếu không con trượt chạy ngược. -->
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="NutLui" Property="Command" Value="ScrollBar.PageLeftCommand" />
                <Setter TargetName="NutToi" Property="Command" Value="ScrollBar.PageRightCommand" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="Height" Value="12" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Ô nhập ===== -->
    <!-- Template mặc định của TextBox có đọc Background, nhưng trigger IsEnabled=False của nó ghi
         đè thành nền sáng + chữ xám của Windows ⇒ ô khóa lòi mảng sáng. Thay hẳn. -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="CaretBrush" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="SelectionBrush" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Vien}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Vo"
                    CornerRadius="3"
                    SnapsToDevicePixels="True"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <!-- Nối thẳng hai cờ thanh cuộn của chính TextBox xuống đây: ScrollViewer trần
                   mặc định là VerticalScrollBarVisibility=Visible, để nguyên thì MỌI ô một dòng
                   mọc thêm thanh cuộn; còn ô ghi chú nhiều dòng của XBOSS_VE_DEXUAT
                   (VerticalScrollBarVisibility="Auto") phải giữ nguyên tác dụng. -->
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoa}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienKhoa}" />
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ô nhập NẰM TRONG ComboBox (IsEditable=True). Phải khai Style tường minh: style ngầm ở trên
         cũng chui vào trong ControlTemplate, và nếu để nó ăn thì ô sẽ có thêm một lớp viền + nền
         thứ hai lồng trong viền của combo. Ở đây chỉ cần phần chữ, chrome do combo vẽ. -->
    <Style x:Key="ONhapTrongCombo" TargetType="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="CaretBrush" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="SelectionBrush" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost"
                          Focusable="False"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Combo ===== -->
    <!-- Nút xổ: CHỈ là vùng bắt chuột trong suốt phủ kín combo. Viền/nền/mũi tên do template của
         chính ComboBox vẽ, để mọi trạng thái (kể cả rê chuột trên phần gõ tay của combo
         IsEditable) đọc được từ đúng một chỗ. -->
    <Style x:Key="NutXoCombo" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="ClickMode" Value="Press" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Vo"
                    SnapsToDevicePixels="True"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!-- Thứ tự có ý nghĩa: trigger sau thắng trigger trước khi cùng đúng. -->
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenRe}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True" />
                  <Condition Property="IsHighlighted" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinhRe}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Vien}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid x:Name="Goc" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
              </Grid.ColumnDefinitions>

              <!-- Lớp dưới cùng: khung của combo (mọi trạng thái đổi màu ở đây). -->
              <Border x:Name="Vo"
                      Grid.ColumnSpan="2"
                      CornerRadius="3"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" />

              <!-- Vùng bắt chuột phủ kín; ở chế độ gõ tay thì ô nhập nằm ĐÈ LÊN cột 0 nên chỉ còn
                   cột mũi tên xổ danh sách — đúng hành vi combo editable của Windows. -->
              <ToggleButton x:Name="NutXo"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource NutXoCombo}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

              <ContentPresenter x:Name="NoiDung"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

              <TextBox x:Name="PART_EditableTextBox"
                       Grid.Column="0"
                       Margin="{TemplateBinding Padding}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Style="{StaticResource ONhapTrongCombo}" />

              <Path x:Name="MuiTen"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Data="M 0,0 L 8,0 L 4,4.5 Z"
                    Fill="{x:Static wpf:MauBangWpf.Chu}" />

              <!-- Danh sách xổ: Popup nằm ngoài cây visual của cửa sổ nên KHÔNG thừa hưởng nền tối
                   — phải tự khai nền/viền, nếu không danh sách vẫn trắng dù combo đã tối. -->
              <Popup x:Name="PART_Popup"
                     Grid.ColumnSpan="2"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border x:Name="VoXo"
                        SnapsToDevicePixels="True"
                        MinWidth="{Binding ActualWidth, ElementName=Goc}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        Background="{x:Static wpf:MauBangWpf.NenO}"
                        BorderBrush="{x:Static wpf:MauBangWpf.Vien}"
                        BorderThickness="1">
                  <!-- Khai thẳng "Auto": ScrollViewer trần mặc định là thanh dọc LUÔN hiện,
                       danh sách 3 mục cũng mọc thanh cuộn. -->
                  <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>

            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                <Setter TargetName="NoiDung" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <!-- Để CUỐI: trạng thái khóa phải thắng mọi trạng thái trên. Đây chính là ca đã hỏng
                   — combo bình thường mà trông như khóa; giờ hai trạng thái cách nhau rất xa. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoa}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienKhoa}" />
                <Setter TargetName="MuiTen" Property="Fill" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Ô chọn ===== -->
    <!-- Ô vuông/tròn của CheckBox và RadioButton là "BulletChrome" của theme Windows: nền sáng,
         dấu tick tối, rê chuột thì ánh xanh Aero. Không có cách nào chỉnh bằng Setter — vẽ lại. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Vien}" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <!-- Nền Transparent để bấm được cả dòng chữ, không chỉ mỗi ô vuông (ngón tay trên
                 máy công trường). -->
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="O"
                      Width="16"
                      Height="16"
                      CornerRadius="3"
                      VerticalAlignment="Center"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1">
                <Path x:Name="Dau"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0,3.5 L 3.5,7 L 9.5,0.5"
                      Stroke="{x:Static wpf:MauBangWpf.Chu}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="O" Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
                <Setter TargetName="Dau" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="O" Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoa}" />
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienKhoa}" />
                <Setter TargetName="Dau" Property="Stroke" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Vien}" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="O"
                      Width="16"
                      Height="16"
                      CornerRadius="8"
                      VerticalAlignment="Center"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1">
                <Ellipse x:Name="Cham"
                         Width="8"
                         Height="8"
                         Visibility="Collapsed"
                         Fill="{x:Static wpf:MauBangWpf.Chu}" />
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="O" Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
                <Setter TargetName="Cham" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="O" Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoa}" />
                <Setter TargetName="O" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienKhoa}" />
                <Setter TargetName="Cham" Property="Fill" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ẩn/hiện cả khối theo một cờ bool của ViewModel (vd CanTang, CanKhoGiay). -->
    <BooleanToVisibilityConverter x:Key="CoThiHien" />

    <!-- Khối chỉ-đọc liệt kê nhiều dòng (xem trước, hệ quả, cảnh báo) — FR6.
         Viền dùng Vien (không phải NenKhoi): NenKhoi chỉ hơn nền cửa sổ vài mức xám nên trên màn
         hình công trường coi như không có viền, khối trôi vào nền. -->
    <Style x:Key="KhoiChiDoc" TargetType="Border">
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Vien}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Nút: nền đặc, cao tối thiểu 32 để bấm được chắc tay trên màn hình DPI cao.
         Hai kiểu nút có HAI template riêng vì hướng đổi màu khi rê chuột NGƯỢC nhau (xem dưới) —
         cố gộp một template thì phải nhét màu qua Tag, khó đọc hơn là chép 12 dòng. -->
    <Style x:Key="NutPhu" TargetType="Button">
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoi}" />
      <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Chu}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Vien}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Vo"
                    CornerRadius="4"
                    SnapsToDevicePixels="True"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <!-- Nút XÁM: rê chuột thì SÁNG lên. Làm đậm thêm sẽ chìm vào nền cửa sổ (cũng xám
                   tối) — khác với nút màu bên dưới. Chữ Chu trên NenRe vẫn 7.3:1. -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenRe}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienSang}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenO}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoa}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienKhoa}" />
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NutChinh" TargetType="Button" BasedOn="{StaticResource NutPhu}">
      <Setter Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
      <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.NutChinh}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Vo"
                    CornerRadius="4"
                    SnapsToDevicePixels="True"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <!-- Nút MÀU: rê chuột thì ĐẬM dần, đúng ADR-0010 — nền accent sáng dần sẽ kéo tương
                   phản với chữ trắng xuống dưới AA (ở đây 5.2:1 → 7.2:1 → 9.7:1 khi nhấn). -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinhRe}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.NutChinhRe}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NutChinhNhan}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.NutChinhNhan}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </Trigger>
              <!-- Nút OK khóa khi CoTheOk=false: template mặc định tô nền SÁNG của Windows ở đây,
                   giữa hộp thoại tối — nay là nền tối phẳng + chữ mờ. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Vo" Property="Background" Value="{x:Static wpf:MauBangWpf.NenKhoa}" />
                <Setter TargetName="Vo" Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.VienKhoa}" />
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.ChuKhoa}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Khối một trường nhập: nhãn + ô, có thể ẩn cả khối bằng DataTrigger. -->
    <Style x:Key="Khoi" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- ===== Nội dung theo lệnh (M106 §7.2) ===== -->

    <!-- XBOSS_VE: 5 câu hỏi nối tiếp của dòng lệnh gộp vào một form (AC3). -->
    <DataTemplate DataType="{x:Type vm:VeTuyenDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Hệ vẽ" />
        <ComboBox ItemsSource="{Binding CacHe}"
                  SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}" Text="Loại tuyến" />
        <ComboBox ItemsSource="{Binding CacLoaiTuyen}"
                  SelectedItem="{Binding Tuyen, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Size (chọn trong danh mục rule pack, hoặc gõ size khác)" />
        <ComboBox IsEditable="True"
                  ItemsSource="{Binding CacSize}"
                  Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaBeRongBien}" />

        <!-- Độ dốc chỉ hiện với tuyến rule pack khai slopeRequired (M100 FR9g). -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel" BasedOn="{StaticResource Khoi}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding CanDoDoc}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Style="{StaticResource Nhan}" Text="Độ dốc (bắt buộc với tuyến này)" />
          <ComboBox IsEditable="True"
                    ItemsSource="{Binding CacDoDoc}"
                    Text="{Binding DoDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_NHANTUYEN: khai hệ/loại/cỡ cho tuyến có sẵn (M107 FR2) — một cỡ cho cả vùng chọn. -->
    <DataTemplate DataType="{x:Type vm:NhanTuyenDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Vùng chọn" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <StackPanel>
            <TextBlock Text="{Binding MoTaSeNhan}" TextWrapping="Wrap" Margin="0,0,0,3" />
            <ItemsControl ItemsSource="{Binding DongBoQua}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Nhan}" Text="Hệ" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}" Text="Loại tuyến" />
        <ComboBox ItemsSource="{Binding CacLoaiTuyen}" SelectedItem="{Binding Tuyen, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Cỡ áp cho TOÀN BỘ vùng chọn (chọn trong danh mục, hoặc gõ cỡ khác)" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacSize}"
                  Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Visibility="{Binding CanDoDoc, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Độ dốc (bắt buộc với tuyến này)" />
          <ComboBox IsEditable="True" ItemsSource="{Binding CacDoDoc}"
                    Text="{Binding DoDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaViecSeLam}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_CHIADOT: phạm vi + kiểu nối + xem trước số đốt (AC4). -->
    <!-- M108 §6.1 — XBOSS_VE_DEXUAT_LO: xem trước danh sách block rồi xác nhận gửi. KHÔNG có ô
         khai metadata: phân loại do máy chủ đề xuất và người duyệt chốt trên web, hộp thoại này
         cố ý không hỏi lại (hai chỗ cùng hỏi một câu là hai chỗ để lệch nhau). -->
    <DataTemplate DataType="{x:Type vm:DeXuatLoDialogViewModel}">
      <StackPanel>
        <Border Style="{StaticResource KhoiChiDoc}">
          <TextBlock Text="{Binding TomTat}" TextWrapping="Wrap" />
        </Border>

        <CheckBox Content="Chỉ gửi block đang được chèn trong bản vẽ"
                  IsChecked="{Binding ChiBlockDangDung, Mode=TwoWay}" Margin="0,8,0,0" />

        <TextBlock Style="{StaticResource Nhan}" Text="Block trong bản vẽ" />
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding TatCa}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding TenBlock}" TextWrapping="Wrap" />
                  <!-- Lý do bỏ qua hiện NGUYÊN VĂN cạnh tên: block biến mất im lặng là thứ người
                       dùng không bao giờ tự phát hiện được. -->
                  <TextBlock Grid.Column="1" Text="{Binding LyDoBoQua}" TextWrapping="Wrap"
                             Opacity="0.75" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChiaDotDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi chia đốt" />
        <RadioButton GroupName="PhamVi"
                     IsChecked="{Binding ChonTay, Mode=TwoWay}"
                     Content="Chọn tay các tuyến trên bản vẽ (sau khi bấm OK)" />
        <RadioButton GroupName="PhamVi"
                     IsChecked="{Binding ChonCaHe, Mode=TwoWay}"
                     Content="Quét mọi tuyến của một hệ" />
        <ComboBox Margin="24,6,0,0"
                  ItemsSource="{Binding CacHe}"
                  SelectedItem="{Binding MucHeChon, Mode=TwoWay}"
                  DisplayMemberPath="Nhan"
                  IsEnabled="{Binding ChonCaHe}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Kiểu nối" />
        <ComboBox ItemsSource="{Binding CacKieuNoi}"
                  SelectedItem="{Binding MucKieuNoiChon, Mode=TwoWay}"
                  DisplayMemberPath="Nhan"
                  IsEnabled="{Binding ChoGhiDeKieuNoi}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaKieuNoi}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Xem trước (engine sẽ vẽ đúng các con số này)" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatXemTruoc}" />
        <!-- Cùng hình thức với mọi khối chỉ-đọc khác: dùng chung Style thay vì chép lại 4 thuộc
             tính (chép tay chính là chỗ viền khối này lệch màu với các khối kia). -->
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DongXemTruoc}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChuPhamVi}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_NHANTANG (M111 FR2/FR3): khai tầng nguồn + tick tầng đích + kiểu dời, và BẢNG XEM
         TRƯỚC BẮT BUỘC (guardrail M111 §2.4 — chép 20 tầng sai là hỏng cả buổi làm việc). Mọi con
         số dưới đây do chính FloorReplicator tính, đúng bộ hàm mà lệnh dùng lúc ghi. -->
    <DataTemplate DataType="{x:Type vm:NhanTangDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Vùng chọn (tầng điển hình)" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <StackPanel>
            <TextBlock Text="{Binding MoTaVungChon}" TextWrapping="Wrap" Margin="0,0,0,3" />
            <ItemsControl ItemsSource="{Binding DongBoQua}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" Opacity="0.85" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource NutPhu}"
                    Content="Zoom tới vùng nguồn"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    Click="BamZoomNguon"
                    Visibility="{Binding CoNutZoom, Converter={StaticResource CoThiHien}}" />
            <TextBlock Style="{StaticResource GhiChu}" Text="{Binding ThongBaoZoom}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Tầng NGUỒN (nhãn {floor} hiện tại — chuỗi, giữ số 0 đứng đầu)" />
        <TextBox Text="{Binding TangNguon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Tầng ĐÍCH (khai trong rule pack)" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacTangDich}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Chon, Mode=TwoWay}" Content="{Binding Nhan}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource Nhan}" Text="Kiểu dời bản chép" />
        <ComboBox ItemsSource="{Binding CacKieuDat}"
                  SelectedItem="{Binding MucKieuDatChon, Mode=TwoWay}"
                  DisplayMemberPath="Nhan" />

        <TextBlock Style="{StaticResource Nhan}" Text="Bước dời giữa 2 tầng liền nhau (mm)" />
        <TextBox Text="{Binding StepMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Visibility="{Binding CoTangDaChep, Converter={StaticResource CoThiHien}}">
          <CheckBox Margin="0,10,0,0"
                    IsChecked="{Binding ChepDe, Mode=TwoWay}"
                    Content="Chép đè tầng đã có bản chép (xóa bản cũ của đúng tầng đó rồi chép lại)" />
          <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaChepDe}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Xem trước (lệnh sẽ ghi đúng những gì liệt kê ở đây)" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatXemTruoc}"
                   TextWrapping="Wrap" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DongXemTruoc}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <StackPanel Visibility="{Binding CoVung, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Tên vùng bóc của bản chép" />
          <Border Style="{StaticResource KhoiChiDoc}">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding DongVung}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- M109 FR7 — XBOSS_VE_NGATNET: phạm vi + danh sách cặp tuyến giao nhau, ô ĐẢO từng dòng.
         Ô đảo là CheckBox bind hai chiều vào DongGiaoNgatNet.DaoTay (ViewModel dòng tự phát
         PropertyChanged) — cố ý KHÔNG dùng Command/code-behind: DataTemplate không có code-behind
         là điểm mấu chốt của khung M106 (xem chú thích đầu tệp). Dòng không ngắt nét được thì ô
         đảo tự mờ và mô tả nói rõ LÝ DO ngay cạnh, không giấu dòng đó đi. -->
    <DataTemplate DataType="{x:Type vm:NgatNetDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi ngắt nét" />
        <RadioButton GroupName="PhamViNgatNet"
                     IsChecked="{Binding ToanBanVe, Mode=TwoWay}"
                     Content="Toàn bộ tuyến XBoss trong bản vẽ" />
        <RadioButton GroupName="PhamViNgatNet"
                     IsChecked="{Binding ChonTay, Mode=TwoWay}"
                     Content="Chọn tay các tuyến trên bản vẽ (sau khi bấm OK)" />

        <TextBlock Style="{StaticResource Nhan}" Text="Các cặp tuyến giao nhau" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTat}" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DanhSach}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Đảo" Margin="0,0,10,0"
                              IsChecked="{Binding DaoTay, Mode=TwoWay}"
                              IsEnabled="{Binding CoTheDao}" />
                    <TextBlock Grid.Column="1" Text="{Binding MoTa}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChuDanhSach}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChuPhamVi}" />
      </StackPanel>
    </DataTemplate>

    <!-- M114 FR2 — XBOSS_VE_HANHLANG: bề rộng khả dụng + cao độ đáy dầm/trần + hệ được phép đi
         qua. Cao độ là ô NHẬP TAY (M100 §6.3 "hỏi, không suy" — bản vẽ 2D không chứa cao độ thật);
         danh sách hệ tick hết = mọi hệ, đúng quy ước "rỗng = mọi hệ" của XData hành lang. Sổ chiếm
         làn chỉ HIỆN RA, không sửa được ở đây: cấp/gỡ làn là việc của XBOSS_VE_TUYENTUDONG. -->
    <DataTemplate DataType="{x:Type vm:HanhLangDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <StackPanel>
            <TextBlock Text="{Binding MoTaSeXuLy}" TextWrapping="Wrap" Margin="0,0,0,3" />
            <ItemsControl ItemsSource="{Binding DongBoQua}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Nhan}" Text="Bề rộng khả dụng của hành lang (mm)" />
        <TextBox Text="{Binding BeRong, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Cao độ ĐÁY DẦM (mm — nhập tay)" />
        <TextBox Text="{Binding CotDayDam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Cao độ TRẦN (mm — nhập tay)" />
        <TextBox Text="{Binding CotTran, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Hệ được phép đi qua (tick hết = mọi hệ)" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacHe}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Margin="0,0,0,3" IsChecked="{Binding Chon, Mode=TwoWay}"
                            Content="{Binding Nhan}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <StackPanel Visibility="{Binding CoChiemCho, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Làn đã cấp cho các hệ (chỉ đọc)" />
          <Border Style="{StaticResource KhoiChiDoc}">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding DongChiemCho}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>

        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaViecSeLam}" />
      </StackPanel>
    </DataTemplate>

    <!-- M114 FR5 + FR10 — XBOSS_VE_TUYENTUDONG: chọn phạm vi (hệ/loại tuyến/cỡ, chế độ tự chảy) và
         BẢNG XEM TRƯỚC BẮT BUỘC trong cùng một form. Đổi hệ/loại/cỡ là ViewModel đi tuyến lại ngay
         nên bảng số và nét mảnh tạm trên bản vẽ luôn nói về đúng lựa chọn đang thấy. Danh sách
         "không giải được" KHÔNG bị giấu đi: guardrail M114 §3.3 — không giải được thì phải nói rõ
         thiết bị nào, vì sao. Bán kính rẽ nhánh/độ dốc không có ô nào sửa được ở đây (§3 cấm nới
         để cho ra kết quả) — chúng chỉ hiện ở dòng ghi chú rule pack. -->
    <DataTemplate DataType="{x:Type vm:TuyenTuDongDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <TextBlock Text="{Binding MoTaPhamVi}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Style="{StaticResource Nhan}" Text="Hệ" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}" Text="Loại tuyến" />
        <ComboBox ItemsSource="{Binding CacLoaiTuyen}" SelectedItem="{Binding Tuyen, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}" Text="Cỡ" />
        <ComboBox ItemsSource="{Binding CacSize}" IsEditable="True"
                  Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <StackPanel Visibility="{Binding CanDoDoc, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Độ dốc (chế độ tự chảy)" />
          <ComboBox ItemsSource="{Binding CacDoDoc}" IsEditable="True"
                    Text="{Binding DoDoc, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Style="{StaticResource Nhan}" Text="Cao độ tim tuyến TẠI THIẾT BỊ (mm — nhập tay)" />
          <TextBox Text="{Binding CaoDoThietBi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Style="{StaticResource Nhan}" Text="Cao độ tim tuyến TẠI ĐIỂM XẢ (mm — nhập tay)" />
          <TextBox Text="{Binding CaoDoXa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <CheckBox Margin="0,10,0,0"
                  IsChecked="{Binding BoQuaThietBiDaCoTuyen, Mode=TwoWay}"
                  Content="Bỏ qua thiết bị đã có tuyến chạy tới" />

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Xem trước (lệnh sẽ ghi đúng những gì liệt kê ở đây)" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatXemTruoc}"
                   TextWrapping="Wrap" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DongCapLan}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Không giải được (lệnh sẽ KHÔNG vẽ gì cho các mục này)" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DongKhongGiai}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaTuyenCu}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChuChinhSach}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding ThongBaoNetTam}" />
      </StackPanel>
    </DataTemplate>

    <!-- ===== M106 PR3 — các lệnh còn lại của bảng §7.2 ===== -->

    <!-- XBOSS_LOGIN: chỉ hỏi địa chỉ server (device pairing, không có email/mật khẩu). -->
    <DataTemplate DataType="{x:Type vm:LoginDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Địa chỉ server XBoss (https://…)" />
        <TextBox Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaCacBuoc}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_UPLOAD: bản vẽ đích + rev; sidecar gửi kèm chỉ hiển thị. -->
    <DataTemplate DataType="{x:Type vm:UploadDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}"
                   Text="Số bản vẽ trong sổ XBoss (vd ACMV-SD-T05-001, hoặc #12)" />
        <TextBox Text="{Binding MaBanVe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Nhan}" Text="Rev (vd A, B, C)" />
        <TextBox Text="{Binding Rev, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaSidecar}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_CHUANHOA: xác nhận thực thi, kèm diff xem trước (chỉ đọc). -->
    <DataTemplate DataType="{x:Type vm:ChuanHoaDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="{Binding TomTat}" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DongXemTruoc}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_BATCH: chọn chế độ (thư mục vẫn chọn bằng hộp thoại hệ thống sau khi bấm OK). -->
    <DataTemplate DataType="{x:Type vm:BatchDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Chế độ" />
        <RadioButton GroupName="CheDoBatch" IsChecked="{Binding LaKiemTra, Mode=TwoWay}"
                     Content="Chỉ kiểm (an toàn, không sửa)" />
        <RadioButton GroupName="CheDoBatch" IsChecked="{Binding LaChuanHoa, Mode=TwoWay}"
                     Content="Chuẩn hóa (bản gốc giữ nguyên, kết quả vào thư mục con)" />
        <RadioButton GroupName="CheDoBatch" IsChecked="{Binding LaBocKL, Mode=TwoWay}"
                     Content="Bóc khối lượng hàng loạt (1 Excel tổng)" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaCheDo}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_BOCKL: phạm vi + bóc theo vùng. -->
    <DataTemplate DataType="{x:Type vm:BocKlDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi bóc" />
        <RadioButton GroupName="PhamViBoc" IsChecked="{Binding LaToanBo, Mode=TwoWay}"
                     Content="Toàn bộ model space" />
        <RadioButton GroupName="PhamViBoc" IsChecked="{Binding LaChonVung, Mode=TwoWay}"
                     Content="Chọn vùng (quét chọn sau khi bấm OK)" />
        <CheckBox IsChecked="{Binding ChiaVung, Mode=TwoWay}"
                  Content="Bóc theo vùng (tầng/zone) — chọn polyline ranh giới rồi đặt tên vùng" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaViecTiepTheo}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_BOCKL_XOA: phạm vi gỡ dấu bóc. -->
    <DataTemplate DataType="{x:Type vm:BocKlXoaDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi gỡ dấu" />
        <RadioButton GroupName="PhamViGoDau" IsChecked="{Binding LaToanBo, Mode=TwoWay}"
                     Content="Toàn bộ model space" />
        <RadioButton GroupName="PhamViGoDau" IsChecked="{Binding LaChonVung, Mode=TwoWay}"
                     Content="Chọn vùng (quét chọn sau khi bấm OK)" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaViecTiepTheo}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_BOCKL_XUAT: meta đầu trang Excel + đối chiếu BOQ. -->
    <DataTemplate DataType="{x:Type vm:BocKlXuatDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Tên dự án" />
        <TextBox Text="{Binding TenDuAn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Nhan}" Text="Gói thầu" />
        <TextBox Text="{Binding GoiThau, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox IsChecked="{Binding DoiChieuBoq, Mode=TwoWay}"
                  Content="Kéo KL BOQ hợp đồng từ máy chủ để dựng sheet &quot;Doi-chieu&quot;" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaDoiChieu}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_NEN: chọn hệ; mức làm mờ/khóa layer do rule pack quyết (chỉ đọc). -->
    <DataTemplate DataType="{x:Type vm:VeNenDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Hệ sắp vẽ" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaViecSeLam}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_NHAN: tỉ lệ in của phiên (nội dung nhãn lấy từ XData của tuyến). -->
    <DataTemplate DataType="{x:Type vm:VeNhanDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Tỉ lệ in 1:x (chọn trong danh mục hoặc gõ số)" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacTiLe}"
                  Text="{Binding TiLe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaCaoChu}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_DOI: hệ/loại/size/độ dốc mới + hệ quả (thay luôn câu xác nhận DongY/Huy). -->
    <DataTemplate DataType="{x:Type vm:VeDoiDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Đang chọn" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TomTatDangChon}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource Nhan}" Text="Hệ mới" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />
        <TextBlock Style="{StaticResource Nhan}" Text="Loại tuyến mới" />
        <ComboBox ItemsSource="{Binding CacLoaiTuyen}" SelectedItem="{Binding Tuyen, Mode=TwoWay}"
                  DisplayMemberPath="Name" />
        <TextBlock Style="{StaticResource Nhan}" Text="Size mới (chọn trong danh mục, hoặc gõ size khác)" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacSize}"
                  Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Visibility="{Binding CanDoDoc, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Độ dốc (bắt buộc với tuyến này)" />
          <ComboBox IsEditable="True" ItemsSource="{Binding CacDoDoc}"
                    Text="{Binding DoDoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Nhan}" Text="Bấm OK sẽ:" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ItemsControl ItemsSource="{Binding HeQua}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_PHUKIEN / XBOSS_VE_THIETBI: hệ + block (cỡ/hướng/attribute theo từng lần chèn). -->
    <DataTemplate DataType="{x:Type vm:ChonBlockDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Hệ" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="He.Name" />
        <TextBlock Style="{StaticResource Nhan}" Text="Block trong thư viện" />
        <ComboBox ItemsSource="{Binding CacBlock}" SelectedItem="{Binding Block, Mode=TwoWay}"
                  DisplayMemberPath="Id" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaBlock}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_GIADO: hệ + block + cách chia (+ phụ kiện nặng với rule pack cũ). -->
    <DataTemplate DataType="{x:Type vm:GiaDoDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Hệ" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="He.Name" />
        <TextBlock Style="{StaticResource Nhan}" Text="Block giá đỡ" />
        <ComboBox ItemsSource="{Binding CacBlock}" SelectedItem="{Binding Block, Mode=TwoWay}"
                  DisplayMemberPath="Id" />

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Cách chia khi chiều dài không chia hết cho khoảng cách chuẩn" />
        <RadioButton GroupName="CheDoGiaDo" IsChecked="{Binding LaKhongVuot, Mode=TwoWay}"
                     Content="Bước luôn ≤ khoảng cách chuẩn (an toàn)" />
        <RadioButton GroupName="CheDoGiaDo" IsChecked="{Binding LaGanNhat, Mode=TwoWay}"
                     Content="Chia đều gần khoảng cách chuẩn nhất (ít giá đỡ hơn)" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaCheDo}" />

        <CheckBox Visibility="{Binding CanHoiTaiPhuKien, Converter={StaticResource CoThiHien}}"
                  IsChecked="{Binding TaiMoiPhuKien, Mode=TwoWay}"
                  Content="Đặt thêm giá đỡ tại MỌI phụ kiện đã chèn trên tuyến" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaPhuKienNang}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaKhoangCach}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_LOCHO: chèn sleeve hay xuất bảng lỗ chờ. -->
    <DataTemplate DataType="{x:Type vm:LoChoDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Việc cần làm" />
        <RadioButton GroupName="CheDoLoCho" IsChecked="{Binding LaChen, Mode=TwoWay}"
                     Content="Chèn sleeve tại chỗ tuyến xuyên kết cấu" />
        <RadioButton GroupName="CheDoLoCho" IsChecked="{Binding LaXuatBang, Mode=TwoWay}"
                     Content="Xuất bảng lỗ chờ (Table trong bản vẽ + Excel)" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaCheDo}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_TAG: chế độ + (chỉ khi đánh lại) phạm vi và tầng. -->
    <DataTemplate DataType="{x:Type vm:TagDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Việc cần làm" />
        <RadioButton GroupName="CheDoTag" IsChecked="{Binding LaQuet, Mode=TwoWay}"
                     Content="Quét trùng/nhảy số (chỉ báo, không sửa)" />
        <RadioButton GroupName="CheDoTag" IsChecked="{Binding LaDanhLai, Mode=TwoWay}"
                     Content="Đánh lại tuần tự" />
        <RadioButton GroupName="CheDoTag" IsChecked="{Binding LaKhoa, Mode=TwoWay}"
                     Content="Khóa tag đang chọn (đánh lại không đổi)" />
        <RadioButton GroupName="CheDoTag" IsChecked="{Binding LaMoKhoa, Mode=TwoWay}"
                     Content="Mở khóa tag đang chọn" />

        <StackPanel Visibility="{Binding CanTang, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Phạm vi đánh lại" />
          <RadioButton GroupName="PhamViTag" IsChecked="{Binding LaToanBo, Mode=TwoWay}"
                       Content="Toàn bộ model space" />
          <RadioButton GroupName="PhamViTag" IsChecked="{Binding LaChonVung, Mode=TwoWay}"
                       Content="Chọn vùng (quét chọn sau khi bấm OK)" />
          <TextBlock Style="{StaticResource Nhan}" Text="Tầng của bản vẽ (điền vào {floor} của tag)" />
          <TextBox Text="{Binding Tang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaCheDo}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_THONGKE: nguồn dữ liệu của bảng + tỉ lệ in. -->
    <DataTemplate DataType="{x:Type vm:ThongKeDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Bảng lấy dữ liệu từ đâu" />
        <RadioButton GroupName="LoaiBang" IsChecked="{Binding LaThietBi, Mode=TwoWay}"
                     Content="Bảng thiết bị (từ attribute TAG/MODEL/SIZE)" />
        <RadioButton GroupName="LoaiBang" IsChecked="{Binding LaKhoiLuong, Mode=TwoWay}"
                     Content="Bảng khối lượng theo hệ (từ trạng thái bóc XBOSS_BOCKL)" />
        <RadioButton GroupName="LoaiBang" IsChecked="{Binding LaChiaDot, Mode=TwoWay}"
                     Content="Bảng đốt theo kiểu nối (từ dấu chia đốt XBOSS_VE_CHIADOT)" />

        <TextBlock Style="{StaticResource Nhan}" Text="Tỉ lệ in 1:x" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacTiLe}"
                  Text="{Binding TiLe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaNguon}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_MATCAT: tỉ lệ + cao độ TỪNG tuyến (tên mặt cắt do plugin tự đánh). -->
    <DataTemplate DataType="{x:Type vm:MatCatDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Tỉ lệ in 1:x" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacTiLe}"
                  Text="{Binding TiLe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Cao độ tim từng tuyến (mm, so với điểm đặt hình cắt)" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacCaoDo}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Nhan}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding GiaTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaTenMatCat}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_TRANGIN: hệ → khổ giấy → tỉ lệ → ẩn layer → CTB → thông tin khung tên. -->
    <DataTemplate DataType="{x:Type vm:TrangInDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Hệ cần in" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Nhan}" Text="Khổ giấy" />
            <ComboBox ItemsSource="{Binding CacKhoGiay}" SelectedItem="{Binding KhoGiay, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Style="{StaticResource Nhan}" Text="Tỉ lệ in 1:x" />
            <ComboBox IsEditable="True" ItemsSource="{Binding CacTiLe}"
                      Text="{Binding TiLe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaTiLe}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Ẩn layer theo viewport (VP freeze)" />
        <RadioButton GroupName="AnLayer" IsChecked="{Binding AnHeKhac, Mode=TwoWay}"
                     Content="Chỉ ẩn tuyến của các hệ MEP khác (giữ nền kiến trúc/trục)" />
        <RadioButton GroupName="AnLayer" IsChecked="{Binding AnNgoaiHe, Mode=TwoWay}"
                     Content="Ẩn mọi layer không thuộc hệ đang in" />
        <RadioButton GroupName="AnLayer" IsChecked="{Binding KhongAn, Mode=TwoWay}"
                     Content="Không ẩn gì" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaAnLayer}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Bảng nét in (CTB)" />
        <ComboBox ItemsSource="{Binding CacCtb}" SelectedItem="{Binding Ctb, Mode=TwoWay}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Thông tin khung tên" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacThe}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Nhan}" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding GiaTri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaKhungTen}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_DEXUAT: bản WPF của DeXuatBlockDialog (M103) — giữ nguyên trường + quy tắc. -->
    <DataTemplate DataType="{x:Type vm:DeXuatBlockDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Tên block" />
        <TextBox Text="{Binding TenBlock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Loại block" />
        <ComboBox ItemsSource="{Binding CacLoai}" SelectedItem="{Binding MucLoaiChon, Mode=TwoWay}"
                  DisplayMemberPath="Nhan" />

        <StackPanel Visibility="{Binding CanHe, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Hệ (layerMap)" />
          <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding MucHeChon, Mode=TwoWay}"
                    DisplayMemberPath="Nhan" />
        </StackPanel>

        <StackPanel Visibility="{Binding CanItem, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Item bóc tách" />
          <ComboBox ItemsSource="{Binding CacItem}" SelectedItem="{Binding MucItemChon, Mode=TwoWay}"
                    DisplayMemberPath="Nhan" />
        </StackPanel>

        <StackPanel Visibility="{Binding CanKhoGiay, Converter={StaticResource CoThiHien}}">
          <TextBlock Style="{StaticResource Nhan}" Text="Khổ giấy" />
          <ComboBox IsEditable="True" ItemsSource="{Binding CacKhoGiay}"
                    Text="{Binding KhoGiay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Nhan}" Text="Ghi chú" />
        <TextBox Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding GhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </DataTemplate>

    <!-- ===== M110 — bộ 3 lệnh revision cloud ===== -->

    <!-- XBOSS_VE_REV: đề xuất vùng khoanh (tick + Zoom tới) hoặc tự chọn vùng bằng chuột. -->
    <DataTemplate DataType="{x:Type vm:RevisionDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Cách chọn vùng khoanh" />
        <RadioButton GroupName="CachKhoanh"
                     IsChecked="{Binding TheoDeXuat, Mode=TwoWay}"
                     Content="Khoanh theo các đề xuất đã tick bên dưới" />
        <RadioButton GroupName="CachKhoanh"
                     IsChecked="{Binding TuChonVung, Mode=TwoWay}"
                     Content="Tự chọn vùng bằng chuột (sau khi bấm OK)" />

        <TextBlock Style="{StaticResource Nhan}" Text="Vùng đã đổi so với mốc revision gần nhất" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTat}" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacDeXuat}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding Chon, Mode=TwoWay}"
                              Content="{Binding Nhan}" />
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="10,2"
                            Content="Zoom tới"
                            Command="{Binding DataContext.LenhZoom,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChuDeXuat}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_REV_CHOT: dòng revision ghi vào khung tên + cảnh báo vùng chưa khoanh (FR5). -->
    <DataTemplate DataType="{x:Type vm:RevChotDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Ngày phát hành (yyyy-MM-dd)" />
        <TextBox Text="{Binding NgayIso, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Nội dung sửa đổi" />
        <TextBox Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding NoiDung, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Người thực hiện" />
        <TextBox Text="{Binding Nguoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Vùng đã đổi mà CHƯA khoanh cloud" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatBoSot}" />
        <Border Style="{StaticResource KhoiChiDoc}"
                Visibility="{Binding CoBoSot, Converter={StaticResource CoThiHien}}">
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DongBoSot}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <CheckBox Margin="0,6,0,0"
                  Visibility="{Binding CoBoSot, Converter={StaticResource CoThiHien}}"
                  IsChecked="{Binding VanChot, Mode=TwoWay}"
                  Content="Vẫn chốt revision dù còn vùng chưa khoanh" />
      </StackPanel>
    </DataTemplate>

    <!-- ===== M115 §6 bước 2–4 — hoàn thiện bản vẽ từ tuyến tim ===== -->

    <!-- XBOSS_TUYEN_GAN (FR1): một bộ thuộc tính áp cho toàn bộ tuyến đang chọn. Hệ được điền sẵn
         theo layerMap nhưng KHÔNG khoá — dòng ghi chú nói rõ đó là gợi ý. Danh sách "còn thiếu"
         mỗi dòng kèm nút Zoom tới, đúng khuôn XBOSS_VE_REV. -->
    <DataTemplate DataType="{x:Type vm:TuyenGanDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Hệ" />
        <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding He, Mode=TwoWay}"
                  DisplayMemberPath="Name" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaSuyHe}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Loại tuyến" />
        <ComboBox ItemsSource="{Binding CacLoaiTuyen}" SelectedItem="{Binding Tuyen, Mode=TwoWay}"
                  DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource Nhan}"
                   Text="Cỡ (chọn trong danh mục rule pack, hoặc gõ cỡ khác)" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacSize}"
                  Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Cao độ tim tuyến (mm — nhập tay)" />
        <TextBox Text="{Binding CaoDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Kiểu nối (danh mục jointRules của loại tuyến)" />
        <ComboBox IsEditable="True" ItemsSource="{Binding CacKieuNoi}"
                  Text="{Binding KieuNoi, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Vật liệu (không bắt buộc)" />
        <TextBox Text="{Binding VatLieu, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Cách nhiệt (không bắt buộc)" />
        <TextBox Text="{Binding CachNhiet, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Style="{StaticResource Nhan}" Text="Tuyến còn thiếu thuộc tính bắt buộc" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTat}" TextWrapping="Wrap" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacTuyenThieu}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Nhan}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,2" Content="Zoom tới"
                            Command="{Binding DataContext.LenhZoom,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding MoTaViecSeLam}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_TUYEN_DOTHI (FR2, AC6): hai danh sách — lỗi chặn/cảnh báo và nút/phụ kiện suy ra.
         Nút OK (= "Chốt đồ thị") tự mờ khi còn lỗi chặn: khung hộp thoại đã bind IsEnabled vào
         CoTheOk, mà ViewModel khoá OK đúng bằng điều kiện KetQuaKiemTuyen.Dat — không có cửa sau. -->
    <DataTemplate DataType="{x:Type vm:TuyenDoThiDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Lỗi chặn &amp; cảnh báo" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatLoi}" TextWrapping="Wrap" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacLoi}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Nhan}" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,2" Content="Zoom tới"
                            Command="{Binding DataContext.LenhZoomLoi,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource Nhan}" Text="Nút &amp; phụ kiện suy ra (sửa được từng dòng)" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatNut}" TextWrapping="Wrap" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacNut}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Nhan}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,2" Content="Zoom tới"
                              Command="{Binding DataContext.LenhZoomNut,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                    <ComboBox Margin="0,3,0,0" ItemsSource="{Binding LuaChon}"
                              SelectedItem="{Binding DangChon, Mode=TwoWay}"
                              DisplayMemberPath="Nhan" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChu}" />
      </StackPanel>
    </DataTemplate>

    <!-- M116 §6 bước 3–4 — XBOSS_PHOIHOP: bảng xung đột phối hợp, lọc theo hệ/mức, mỗi dòng bấm
         "Zoom tới" và đánh dấu CHẤP NHẬN / BỎ QUA (ô lý do bắt buộc khi bỏ qua — ViewModel khóa nút
         OK kèm lý do, XAML không tự kiểm lại). Hai ô đánh dấu là CheckBox bind hai chiều vào
         DongXungDot (dòng tự phát PropertyChanged), cố ý không dùng code-behind: DataTemplate không
         có code-behind là điểm mấu chốt của khung M106 (xem chú thích đầu tệp). -->
    <DataTemplate DataType="{x:Type vm:PhoiHopDialogViewModel}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Nhan}" Text="Lọc theo hệ" />
            <ComboBox ItemsSource="{Binding CacHe}" SelectedItem="{Binding HeLoc, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Style="{StaticResource Nhan}" Text="Lọc theo mức" />
            <ComboBox ItemsSource="{Binding CacMuc}" SelectedItem="{Binding MucLoc, Mode=TwoWay}"
                      DisplayMemberPath="Nhan" />
          </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource Nhan}" Text="Xung đột phát hiện được" />
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTat}" TextWrapping="Wrap" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DanhSach}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Nhan}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Margin="10,0,0,0" Padding="10,2" Content="Zoom tới"
                              Command="{Binding DataContext.LenhZoom,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </Grid>
                    <TextBlock Style="{StaticResource GhiChu}" Text="{Binding NhanDeXuat}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <CheckBox Content="Chấp nhận (tự sửa tay)" Margin="0,0,14,0"
                                IsChecked="{Binding ChapNhan, Mode=TwoWay}" />
                      <CheckBox Content="Bỏ qua có lý do" IsChecked="{Binding BoQua, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBox Margin="0,3,0,0" IsEnabled="{Binding BoQua}"
                             Text="{Binding LyDo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChuDanhSach}" />
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChu}" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_HOANTHIEN (M115 FR3): tick 8 giai đoạn hoàn thiện. Mặc định tick theo
         completionPolicy.stageDefaults; thứ tự chạy CỐ ĐỊNH ① → ⑧ nên danh sách cũng hiện đúng
         thứ tự đó, kỹ sư không hiểu nhầm là tick trước chạy trước. -->
    <DataTemplate DataType="{x:Type vm:HoanThienDialogViewModel}">
      <StackPanel>
        <TextBlock Foreground="{x:Static wpf:MauBangWpf.Chu}" Text="{Binding TomTatDoThi}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Nhan}" Text="Giai đoạn cần chạy (thứ tự chạy ① → ⑧)" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacGiaiDoan}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,6">
                    <CheckBox IsChecked="{Binding Bat, Mode=TwoWay}" Content="{Binding Nhan}" />
                    <TextBlock Style="{StaticResource GhiChu}" Margin="22,0,0,0"
                               Text="{Binding GhiChu}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChu}" TextWrapping="Wrap" />
      </StackPanel>
    </DataTemplate>

    <!-- XBOSS_VE_REV_HIENTHI: tick revision cần HIỆN (mỗi revision một layer con). -->
    <DataTemplate DataType="{x:Type vm:HienThiRevisionDialogViewModel}">
      <StackPanel>
        <TextBlock Style="{StaticResource Nhan}" Text="Revision cần hiện trên bản vẽ" />
        <Border Style="{StaticResource KhoiChiDoc}">
          <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CacRevision}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Margin="0,0,0,4"
                            IsChecked="{Binding Hien, Mode=TwoWay}"
                            Content="{Binding Nhan}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <TextBlock Style="{StaticResource GhiChu}" Text="{Binding GhiChu}" />
      </StackPanel>
    </DataTemplate>

  </Window.Resources>

  <Grid Margin="18,14,18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Đầu hộp thoại: tên lệnh + gạch phân cách. Thanh tiêu đề của Windows cũng mang chuỗi này,
         NHƯNG nó nằm ngoài vùng mắt đọc (chữ nhỏ, sát mép, lẫn với chrome của AutoCAD) — kỹ sư mở
         6-7 hộp thoại liền tay cần thấy NGAY đang ở lệnh nào. Cùng bậc chữ với tiêu đề thẻ trên
         bảng XBoss (xem ThanhPhan.TieuDeThe). -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="{Binding TieuDe}"
                 Foreground="{x:Static wpf:MauBangWpf.Chu}"
                 FontSize="15"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <Border Margin="0,8,0,0" Height="1" Background="{x:Static wpf:MauBangWpf.Vien}" />
    </StackPanel>

    <!-- Câu dẫn là thứ ĐẦU TIÊN kỹ sư đọc trong phần thân → Chu, không để mờ như ghi chú phụ. -->
    <TextBlock Grid.Row="1"
               Style="{StaticResource GhiChu}"
               Foreground="{x:Static wpf:MauBangWpf.Chu}"
               Margin="0,0,0,6"
               Text="{Binding MoTa}" />

    <!-- Cuộn được: form dài nhất (XBOSS_VE_TRANGIN, XBOSS_VE_MATCAT nhiều tuyến) vẫn vừa màn hình
         laptop 768px mà không phải bỏ trường nào. -->
    <ScrollViewer Grid.Row="2" MaxHeight="560" VerticalScrollBarVisibility="Auto">
      <ContentControl Content="{Binding}" />
    </ScrollViewer>

    <!-- Vùng lý do: nút OK khóa thì đây nói RÕ vì sao (FR2). Có viền để tách hẳn khỏi nền cửa sổ —
         NenKhoi chỉ hơn Nen vài mức xám, không viền thì vùng này gần như vô hình. Vệt màu 3px ở
         cạnh trái + KÝ HIỆU đứng trước câu (⛔/⚠/✓) để trạng thái không nằm riêng ở màu chữ:
         cùng luật "không truyền tải thông tin chỉ bằng màu" mà bảng XBoss và web đang theo. -->
    <Border Grid.Row="3"
            Margin="0,14,0,0"
            BorderBrush="{x:Static wpf:MauBangWpf.Vien}"
            BorderThickness="1">
      <Border Padding="10,8" Background="{x:Static wpf:MauBangWpf.NenKhoi}">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.CanhBao}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding MucDo}" Value="{x:Static vm:MucThongDiep.Tot}">
                <Setter Property="BorderBrush" Value="{x:Static wpf:MauBangWpf.Tot}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <!-- Grid 2 cột (KHÔNG StackPanel ngang): trong StackPanel ngang, phần tử được đo với bề
             rộng vô hạn nên TextWrapping không bao giờ ăn — câu lý do dài chạy thẳng ra ngoài cửa
             sổ rộng cố định 660 và bị cắt. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Top">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.CanhBao}" />
                <Setter Property="Text" Value="⚠" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding MucDo}" Value="{x:Static vm:MucThongDiep.Loi}">
                    <Setter Property="Text" Value="⛔" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding MucDo}" Value="{x:Static vm:MucThongDiep.Tot}">
                    <Setter Property="Text" Value="✓" />
                    <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Tot}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding ThongDiep}" TextWrapping="Wrap">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.CanhBao}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding MucDo}" Value="{x:Static vm:MucThongDiep.Tot}">
                    <Setter Property="Foreground" Value="{x:Static wpf:MauBangWpf.Tot}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
    </Border>

    <StackPanel Grid.Row="4"
                Margin="0,14,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Style="{StaticResource NutChinh}"
              Content="OK"
              IsDefault="True"
              IsEnabled="{Binding CoTheOk}"
              Click="BamOk" />
      <Button Style="{StaticResource NutPhu}"
              Content="Hủy"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
