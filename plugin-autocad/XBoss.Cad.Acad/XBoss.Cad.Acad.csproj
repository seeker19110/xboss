<Project Sdk="Microsoft.NET.Sdk">

  <!--
    XBoss.Cad.Acad — Adapter AutoCAD (M99 §9): dịch giữa API AutoCAD và XBoss.Cad.Core.
    Chỉ build được trên Windows có ObjectARX SDK 2026 + **.NET 10 SDK** (không build trong CI —
    CI chỉ build/test Core). Truyền đường dẫn SDK qua:
      dotnet build -p:AcadSdkDir="C:\ObjectARX2026\inc-x64"
    hoặc đặt biến môi trường AcadSdkDir. Xem plugin-autocad/README.md.
  -->
  <PropertyGroup>
    <!--
      net10.0-windows: AutoCAD 2026 sau bản cập nhật 2026-08-25 dùng Managed API build cho .NET 10
      (`acmgd.dll` = `.NETCoreApp,Version=v10.0`; trước bản cập nhật là v8.0 — cùng một lệnh kiểm,
      cùng một tệp, hai kết quả khác nhau trong một buổi sáng). Managed API KHÔNG tương thích lùi:
      build cho net8.0 mà tham chiếu assembly net10 thì trình biên dịch chặn thẳng bằng CS1705
      ("uses System.Runtime 10.0.0.0 which has a higher version"). Xem M99 §9.1.
      XBoss.Cad.Core vẫn giữ net8.0 — nó không tham chiếu assembly AutoCAD, giữ nền thấp để CI
      Linux build/test được, và app net10 vẫn tham chiếu thư viện net8 bình thường.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XBoss.Cad.Acad</RootNamespace>
    <!-- Nạp trong process AutoCAD — không copy runtime assembly của AutoCAD đi kèm. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Hộp thoại chọn/lưu tệp của Autodesk.AutoCAD.Windows trả DialogResult của WinForms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Ribbon (Autodesk.Windows trong AdWindows.dll — M102) xây trên WPF: RibbonButton
         cần System.Windows.Input.ICommand + hạ tầng WPF lúc biên dịch. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Target Name="KiemAcadSdkDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(AcadSdkDir)' == '' OR !Exists('$(AcadSdkDir)\acdbmgd.dll')"
      Text="Thiếu ObjectARX SDK 2026: đặt -p:AcadSdkDir=&quot;đường dẫn chứa acdbmgd.dll/acmgd.dll/accoremgd.dll&quot; (thư mục inc-x64 của SDK, hoặc thư mục cài AutoCAD 2026). Dự án này KHÔNG build trong CI — xem plugin-autocad/README.md." />
  </Target>

  <ItemGroup>
    <!-- Managed API của AutoCAD 2026 — CopyLocal=false (M99 §9.1): AutoCAD cung cấp lúc chạy. -->
    <Reference Include="acdbmgd">
      <HintPath>$(AcadSdkDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadSdkDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadSdkDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Ribbon API (namespace Autodesk.Windows — M102). AdWindows.dll nằm cùng thư mục
         acmgd.dll trong cả ObjectARX SDK (inc-x64) lẫn thư mục cài AutoCAD 2026. -->
    <Reference Include="AdWindows">
      <HintPath>$(AcadSdkDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../XBoss.Cad.Core/XBoss.Cad.Core.csproj" />
  </ItemGroup>

</Project>
