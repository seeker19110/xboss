<Project>
  <!-- Cấu hình chung cho mọi project trong plugin-autocad/ (M99 §9.1: chỉ .NET 8) -->
  <PropertyGroup>
    <!--
      Nguồn version DUY NHẤT cho toàn bộ plugin (M99-M108): dong-goi.ps1 đọc thẻ này để đặt
      AppVersion trong bundle/PackageContents.xml lúc đóng gói và đặt tên tệp .zip phát hành
      (dist\XBoss.bundle-<version>.zip). Đổi version thì chỉ sửa DUY NHẤT ở đây.
      1.0.0: mốc phát hành đầu tiên có gói cài — đã qua M99 (đóng gói/cài đặt cơ bản) đến
      M105 (thư viện block 2 chiều ở M104, chia đốt MEPF ở M105), đủ 26 lệnh XBOSS_* theo LenhCatalog.
    -->
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
